# Directorio local de proveedores y módulos descargados por
# "terraform init". Se regenera en cada máquina/pipeline; no aporta
# nada versionar binarios de proveedor.
**/.terraform/

# El archivo de estado NUNCA se versiona: contiene, en texto plano,
# los valores de todos los atributos de los recursos gestionados,
# incluidos datos sensibles. Vive exclusivamente en el backend remoto
# azurerm.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Registro de fallos de "terraform crash", puede contener valores
# en memoria al momento del error.
crash.log
crash.*.log

# Archivos de variables locales que un desarrollador pueda crear para
# pruebas con datos reales (nombres/URLs/IDs de un tenant real). Los
# *.tfvars versionados en este repositorio (dev.tfvars, prod.tfvars)
# contienen únicamente placeholders ilustrativos.
*.auto.tfvars
local.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Archivo de plan binario, puede contener valores sensibles resueltos.
*.tfplan

# Overlay de variables sensibles que el pipeline de CI/CD genera en
# tiempo de ejecución desde GitHub Secrets (mismo patrón que
# local.tfvars, pero efímero en el runner) — nunca versionado.
ci.tfvars.json
plan_output.txt

# Proyecto .NET de las Azure Functions (functions/NovaPay.Payments).
# local.settings.json es config de desarrollo local (nombres de
# recursos por ambiente) — se versiona solo el .example sin datos de
# un tenant real.
functions/**/bin/
functions/**/obj/
functions/**/local.settings.json
